#!/usr/bin/env bash
#
# Обновить Flat Hunter (macOS) — запускается двойным кликом в Finder.
# Скачивает свежую версию из GitHub. После этого просто откройте
# "Мою базу" — расширение перезагрузится в новую версию само.

cd "$(dirname "$0")" || exit 1

echo "🔄 Обновляю Flat Hunter…"
echo

if git pull --ff-only; then
  echo
  echo "✅ Готово! Откройте «Мою базу» (или нажмите «Обновить» в окне расширения) —"
  echo "   новая версия применится сама. Сохранённые квартиры не пропадут."
else
  echo
  echo "❌ Не удалось обновить. Пришлите текст выше в чат с Claude."
fi

echo
read -n 1 -s -r -p "Нажмите любую клавишу, чтобы закрыть окно…"
