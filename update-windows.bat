@echo off
rem Обновить Flat Hunter (Windows) — запускается двойным кликом.
rem Скачивает свежую версию из GitHub. После этого просто откройте
rem "Мою базу" — расширение перезагрузится в новую версию само.

chcp 65001 >nul
cd /d "%~dp0"

echo Обновляю Flat Hunter...
echo.

git pull --ff-only
if errorlevel 1 (
  echo.
  echo [X] Не удалось обновить. Пришлите текст выше в чат с Claude.
) else (
  echo.
  echo [OK] Готово! Откройте "Мою базу" ^(или нажмите "Обновить" в окне расширения^) -
  echo      новая версия применится сама. Сохраненные квартиры не пропадут.
)

echo.
pause
